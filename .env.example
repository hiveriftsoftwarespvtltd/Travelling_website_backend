# ===============================
# 💎 JWT CONFIG
# ===============================
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
ACCESS_TOKEN_TTL=30d
REFRESH_TOKEN_TTL=7d

# ===============================
# 💎 DATABASE (MONGODB ATLAS)
# ===============================
MONGO_URI=your_mongodb_uri
MONGODB_URI=your_mongodb_uri

# ===============================
# 💎 GOOGLE AUTH / ADMIN
# ===============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password

# ===============================
# 💎 EMAIL / SMTP SETTINGS
# ===============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
MAIL_FROM="Jiyo Life Travel <your_email@gmail.com>"
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# ===============================
# 💎 RAZORPAY PAYMENT GATEWAY
# ===============================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ===============================
# SERVER
# ===============================
NODE_ENV=production
PORT=8009

# ─── [ACTIVE] LIVE PRODUCTION SERVER CONFIG (api.jiyolifetravel.com) ───
SERVER_BASE_URL=https://api.jiyolifetravel.com
BACKEND_URL=https://api.jiyolifetravel.com
FRONTEND_URL=https://jiyolifetravel.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://jiyolifetravel.com,https://www.jiyolifetravel.com,https://api.jiyolifetravel.com

# ===============================
# ✈️ TBO FLIGHT API (LIVE PRODUCTION)
# ===============================
TBO_AUTH_BASE_URL=https://api.travelboutiqueonline.com/SharedAPI/SharedData.svc/rest
TBO_AIR_SEARCH_BASE_URL=https://tboapi.travelboutiqueonline.com/AirAPI_V10/AirService.svc/rest
TBO_AIR_BOOK_BASE_URL=https://booking.travelboutiqueonline.com/AirAPI_V10/AirService.svc/rest
TBO_CLIENT_ID=TBOPROD
TBO_USERNAME=DELJ075
TBO_PASSWORD=your_tbo_password
END_USER_IP=68.178.170.69
